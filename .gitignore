# =============================================================================
# .gitignore for a Vivado FPGA project
# Principle: sources + Tcl scripts go into Git, everything generated stays out.
# =============================================================================

# ---- the entire generated Vivado project directory ----
# The project is regenerated via scripts/create_project.tcl.
/vivado/
*.xpr
*.xpr.bak

# ---- Vivado run/cache/gen directories (always derived) ----
*.cache/
*.runs/
*.gen/
*.sim/
*.hw/
*.ip_user_files/
*.srcs/sources_1/bd/*/ip/
.Xil/

# ---- logs / journals / temporary files ----
*.jou
*.log
*.str
*.pb
*.rpt
*.dcp
vivado*.backup.jou
vivado*.backup.log
webtalk*.jou
webtalk*.log
usage_statistics_webtalk*

# ---- bitstreams / hardware exports (build artifacts) ----
*.bit
*.bin
*.ltx
*.xsa
*.mcs
*.prm

# ---- software build artifacts ----
software/build/
*.elf
*.o
*.map
# .bin is already blocked above; if you DO want to keep an app binary:
#   git add -f software/dist/xyz.bin

# ---- editor / OS ----
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db